# FlowForge Environment Configuration
# Duplicate this file as .env for local development

# Security
SECRET_KEY=insecure-dev-secret-key-change-in-production-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web

# Database Configuration (Docker Compose default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=flowforge
DB_USER=flowforge
DB_PASSWORD=flowforge
DB_HOST=localhost
DB_PORT=5432
