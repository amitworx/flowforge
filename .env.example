# ==============================================================================
# FlowForge Environment Configuration Template
# ==============================================================================
# WARNING: The values below are strictly for local DEVELOPMENT and testing only.
# NEVER deploy with these credentials or defaults in production or staging.
# In non-development environments, the application will refuse to start if
# insecure defaults are detected.
#
# Duplicate this file as `.env` for local development:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
# ==============================================================================

# Environment mode: 'development', 'production', 'staging', 'test'
ENVIRONMENT=development

# Application Security
SECRET_KEY=insecure-dev-secret-key-change-in-production-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],web

# Database Configuration (Docker Compose local default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=flowforge
DB_USER=flowforge
DB_PASSWORD=flowforge
DB_HOST=localhost
DB_PORT=5432

# Docker Compose Port Mappings (Host bind settings)
# To bind PostgreSQL only to localhost on the host machine:
DB_HOST_BIND=127.0.0.1
HOST_DB_PORT=5432
PORT=8001
